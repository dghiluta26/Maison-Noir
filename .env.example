# Copy this file to .env and adjust the values for your machine:
#   cp .env.example .env
# Never commit the real .env file.

# --- PostgreSQL (used by docker-compose and by Django) ---
POSTGRES_DB=maison_noir
POSTGRES_USER=maison_noir
POSTGRES_PASSWORD=change-me-locally
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Django (used from step 0.4) ---
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=replace-with-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Refresh-token cookie over HTTPS only. Keep False for http://localhost; True in production.
AUTH_COOKIE_SECURE=False

# --- Frontend (Vite) ---
VITE_API_BASE_URL=http://localhost:8000/api
